<Project Sdk="Microsoft.NET.Sdk">

  <!-- The package ships MSBuild props and analyzer configuration only. Its files, metadata and
       dependencies come from the .nuspec, so the package targets no framework and its dependencies
       apply to every consumer. The project itself compiles nothing that goes into the package. -->
  <PropertyGroup>
    <Version>3.2.2</Version>
    <TargetFramework>net10.0</TargetFramework>
    <NuspecFile>Csag.CodeAnalysis.nuspec</NuspecFile>
    <NuspecProperties>version=$(Version)</NuspecProperties>
  </PropertyGroup>

</Project>
